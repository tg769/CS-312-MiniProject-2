<%- include('partials/header') %>

<div class="row">
  <div class="col-md-5 mb-3">
    <img src="<%= drink.strDrinkThumb %>" alt="<%= drink.strDrink %>" class="img-fluid rounded">
  </div>
  <div class="col-md-7">
    <h1><%= drink.strDrink %></h1>
    <p>
      <span class="badge bg-secondary"><%= drink.strCategory %></span>
      <span class="badge bg-secondary"><%= drink.strAlcoholic %></span>
      <span class="badge bg-secondary"><%= drink.strGlass %></span>
    </p>

    <h4>Ingredients</h4>
    <ul class="list-group mb-3">
      <% ingredients.forEach(function(item) { %>
        <li class="list-group-item"><%= item.measure %> <%= item.ingredient %></li>
      <% }); %>
    </ul>

    <h4>Instructions</h4>
    <p><%= drink.strInstructions %></p>
  </div>
</div>

<% if (meal) { %>
  <hr>
  <div class="row mt-4 align-items-center">
    <div class="col-12">
      <h4>Hungry too? This pairs well with:</h4>
    </div>
    <div class="col-md-3 mb-3">
      <img src="<%= meal.strMealThumb %>" alt="<%= meal.strMeal %>" class="img-fluid rounded">
    </div>
    <div class="col-md-9">
      <h5><%= meal.strMeal %></h5>
      <p class="text-muted"><%= meal.strCategory %> - <%= meal.strArea %> cuisine</p>
    </div>
  </div>
<% } %>

<a href="/" class="btn btn-link mt-3">Back to search</a>

<%- include('partials/footer') %>
